import argparse
import sys
from dataclasses import dataclass
from math import sqrt, asin, pi
from typing import List, Optional, Iterator
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
import os
import pandas as pd
import cv2
from skimage.morphology import skeletonize, remove_small_objects

@dataclass(frozen=True)
class Point:
    x: float
    y: float

    @property
    def index(self) -> int:
        return round(self.x)

    def __repr__(self) -> str:
        return f"({self.x:.1f}, {self.y:.1f})"

# --- utilitários mantidos ---
def euclidean_distance(x: float, y: float) -> float:
    return sqrt(x**2 + y**2)

def angle_from_offsets(x: float, y: float) -> float:
    dist = euclidean_distance(x, y)
    if dist < 1e-6:
        return 0.0
    return asin(y / dist) * 180 / pi

def flatten(lst):
    return [item for sublist in lst for item in sublist]

def find_contiguous_regions(one_dim_image: np.ndarray) -> List[tuple]:
    regions = []
    start = None
    for idx, val in enumerate(one_dim_image):
        if val > 0 and start is None:
            start = idx
        elif val == 0 and start is not None:
            regions.append((start, idx - 1))
            start = None
    if start is not None:
        regions.append((start, len(one_dim_image) - 1))
    return regions

# --- extração de pontos ---
def get_point_locations(image: np.ndarray) -> List[List[Point]]:
    h, w = image.shape
    locations: List[List[Point]] = []
    for x in range(w):
        ys = np.where(image[:, x] > 0)[0]
        points = [Point(float(x), float(y)) for y in ys]
        locations.append(points)
    return locations

# funções de pontuação mantidas

def distance_between_points(a: Point, b: Point) -> float:
    return euclidean_distance(a.x - b.x, a.y - b.y)

def angle_between_points(a: Point, b: Point) -> float:
    dx = b.x - a.x
    dy = b.y - a.y
    return angle_from_offsets(dx, dy)

def angle_similarity(a1: float, a2: float) -> float:
    d = abs(a1 - a2)
    return (180 - min(d, 360 - d)) / 180

def path_score(cur: Point, cand: Point, cand_angle: float) -> float:
    DY_WEIGHT = 1.0      
    ANGLE_WEIGHT = 0.3   

    dy = abs(cur.y - cand.y) 
    ang = angle_between_points(cand, cur)
    ang_diff = 1 - angle_similarity(ang, cand_angle)

    return dy * DY_WEIGHT + ang_diff * ANGLE_WEIGHT

def get_adjacent_points(points_by_col, dp, col, lookback=3, max_dy=30):
    lb = max(0, col - lookback)
    cands = []
    ref_pts = points_by_col[col]

    for ci in range(lb, col):
        for p in points_by_col[ci]:
            if p in dp:
                if any(abs(p.y - ref.y) <= max_dy for ref in ref_pts):
                    s, _, ang = dp[p]
                    cands.append((s, p, ang))
    return cands

def interpolate_points(a: Point, b: Point) -> Iterator[Point]:
    if abs(a.x - b.x) < 1e-6:
        yield a
        return
    m = (b.y - a.y) / (b.x - a.x)
    for x in np.arange(min(a.x, b.x), max(a.x, b.x), 1.0):
        y = a.y + m * (x - a.x)
        yield Point(x, y)

def points_to_signal(points: List[Point], w: int, h: int) -> np.ndarray:
    if not points:
        return np.array([np.nan] * w)
    pts = sorted(points, key=lambda p: p.x)
    sig = np.full(w, np.nan)
    for i in range(len(pts) - 1):
        s, e = pts[i], pts[i + 1]
        if 0 <= s.index < w:
            sig[s.index] = s.y
        for p in interpolate_points(s, e):
            ix = p.index
            if 0 <= ix < w and np.isnan(sig[ix]):
                sig[ix] = p.y
    if pts and 0 <= pts[-1].index < w:
        sig[pts[-1].index] = pts[-1].y
    return h - sig

def extract_signal(bin_img: np.ndarray, debug: bool = False) -> Optional[tuple]:
    h, w = bin_img.shape
    pts_by_col = get_point_locations(bin_img)
    all_pts = flatten(pts_by_col)
    if not all_pts:
        return None
    if debug:
        plt.figure(figsize=(10, 5))
        plt.imshow(bin_img, cmap='gray')
        xs = [p.x for p in all_pts]
        ys = [p.y for p in all_pts]
        plt.scatter(xs, ys, s=2, c='red', alpha=0.5)
        plt.title('Pontos detectados')
        plt.show()
    dp = {p: (0.0, None, 0.0) for p in pts_by_col[0]}
    for ci in range(1, len(pts_by_col)):
        for cur in pts_by_col[ci]:
            cands = get_adjacent_points(pts_by_col, dp, cur.index)
            if not cands:
                dp[cur] = (0.0, None, 0.0)
                continue
            best, prv, ang0 = float('inf'), None, 0.0
            for sc, pp, ang in cands:
                tot = sc + path_score(cur, pp, ang)
                if tot < best:
                    best, prv, ang0 = tot, pp, angle_between_points(pp, cur)
            dp[cur] = (best, prv, ang0)
    end_col = max(0, w - w // 10)
    ends = [(dp[p][0], p) for col in pts_by_col[end_col:] for p in col if p in dp]
    if not ends:
        return None
    _, best_end = min(ends, key=lambda x: x[0])
    path = []
    cur = best_end
    while cur is not None:
        path.append(cur)
        _, cur, _ = dp[cur]
    path.reverse()
    if debug:
        plt.figure(figsize=(10, 5))
        plt.imshow(255 - bin_img, cmap='gray')
        xs = [p.x for p in path]
        ys = [p.y for p in path]
        plt.plot(xs, ys, 'r-', linewidth=1.5)
        plt.title('Caminho otimo')
        plt.show()
    signal = points_to_signal(path, w, h)
    return path, signal

def remove_grid_adaptively(img_array: np.ndarray, initial_threshold: int = 180, min_area: int = 50, debug: bool = False) -> np.ndarray:
    _, binary = cv2.threshold(img_array, initial_threshold, 255, cv2.THRESH_BINARY_INV)
    cleaned = cv2.medianBlur(binary, 3)

    bool_img = cleaned > 0
    filtered = remove_small_objects(bool_img, min_size=min_area)
    filtered_img = (filtered.astype(np.uint8) * 255)

    skel = skeletonize(filtered_img // 255)
    result = (skel * 255).astype(np.uint8)

    if debug:
        plt.figure(figsize=(10, 4))
        plt.imshow(result, cmap='gray')
        plt.title(f'Saida apos threshold={initial_threshold}')
        plt.axis('off')
        plt.show()

    return result

def extract_signal_direct(bin_img: np.ndarray, debug: bool = False) -> Optional[np.ndarray]:
    h, w = bin_img.shape
    signal = np.full(w, np.nan)

    for x in range(w):
        ys = np.where(bin_img[:, x] > 0)[0]
        if len(ys) > 0:
            signal[x] = np.median(ys) 
    if debug:
        plt.figure(figsize=(10, 4))
        plt.imshow(bin_img, cmap='gray')
        plt.plot(range(w), signal, 'r-', linewidth=1.2)
        plt.title("Extração direta por mediana")
        plt.axis('off')
        plt.show()

    return h - signal  

def process_lotes(root_dir: str, threshold: int = 180, min_area: int = 50, debug: bool = False):
    out_dir = root_dir.rstrip('/\\') + '_extraidos'
    os.makedirs(out_dir, exist_ok=True)
    for lote in sorted(os.listdir(root_dir)):
        dir_lote = os.path.join(root_dir, lote)
        if not os.path.isdir(dir_lote):
            continue
        lote_out = os.path.join(out_dir, lote)
        csv_dir = os.path.join(lote_out, 'csv')
        os.makedirs(csv_dir, exist_ok=True)
        for img_name in sorted(os.listdir(dir_lote)):
            if not img_name.lower().endswith('.png'):
                continue
            img_path = os.path.join(dir_lote, img_name)
            arr = np.array(Image.open(img_path).convert('L'))
            arr = arr[120:, :]
            proc = remove_grid_adaptively(arr, initial_threshold=threshold, min_area=min_area, debug=debug)
            sig = extract_signal_direct(proc, debug=debug)
            if sig is None:
                print(f"  [X] Nenhum sinal extrado: {img_name}")
                continue
            base = os.path.splitext(img_name)[0]
            pd.DataFrame({'sinal': sig}).to_csv(os.path.join(csv_dir, f"{base}_sinal.csv"), index=False)
            print(f"  [✔] CSV sinal salvo: {base}_sinal.csv")
            fig, ax = plt.subplots(figsize=(12, 4))
            ax.plot(sig)
            ax.set_xlim(0, len(sig))
            if debug:
                ax.set_title(f'Sinal e pontos: {base}')
            plt.tight_layout()
            plt.savefig(os.path.join(lote_out, f"{base}_sinal.png"))
            plt.close()
            print(f"  [✔] Gráfico salvo: {base}_sinal.png")

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('diretorio')
    parser.add_argument('--threshold', type=int, default=180)
    parser.add_argument('--min_area', type=int, default=50, help='area minima em pixels para manter componentes')
    parser.add_argument('--debug', action='store_true')
    args = parser.parse_args()
    process_lotes(args.diretorio, threshold=args.threshold, min_area=args.min_area, debug=args.debug)
